[Unit]
Description=claude-system dashboard (LAN-only FastAPI)
After=network.target

[Service]
Type=simple
ExecStart={{REPO_ROOT}}/dashboard/.venv/bin/claude-dashboard
Restart=on-failure
RestartSec=5
# Values baked in by install.sh from ~/.claude/.env (with defaults).
Environment=CLAUDE_DASHBOARD_BIND={{DASHBOARD_BIND}}
Environment=PROJECTS_ROOT={{PROJECTS_ROOT}}
Environment=DISK_MONITOR_PATH={{DISK_MONITOR_PATH}}
# Quota calibration overrides (empty = defaults in coordinator/ccusage.py).
Environment=QUOTA_5H_TOKEN_LIMIT={{QUOTA_5H_TOKEN_LIMIT}}
Environment=QUOTA_WEEKLY_COST_LIMIT_USD={{QUOTA_WEEKLY_COST_LIMIT_USD}}
Environment=QUOTA_WEEKLY_TOKEN_LIMIT={{QUOTA_WEEKLY_TOKEN_LIMIT}}
Environment=QUOTA_WEEKLY_RESET_HOUR={{QUOTA_WEEKLY_RESET_HOUR}}
Environment=QUOTA_WEEKLY_RESET_WEEKDAY={{QUOTA_WEEKLY_RESET_WEEKDAY}}
WorkingDirectory={{REPO_ROOT}}

[Install]
WantedBy=default.target
