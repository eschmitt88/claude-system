# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Node / build (none yet, but in case dashboard grows)
node_modules/
dist/

# Runtime state — never committed
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets
.env
*.secret

# Machine-specific service/port registry (copy services.example.yaml) —
# contains real hostnames/IPs, never committed
registry/services.yaml

# Scheduled-run cron wrappers live in ~/.claude/schedule/ and are NEVER
# tracked: this repo is public and they carry notification topics (the topic
# name is the credential), absolute paths, private project names, and
# bypassPermissions invocations. Guard against an accidental copy-in.
# Reusable, secret-free logic belongs in claude/lib/ instead. See README.
claude/schedule/

# OS / editor
.DS_Store
*.swp

# Hook runtime artifacts
claude/hooks/auto-push.err
